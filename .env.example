# Optional cloud sync. Leave both unset and Homebase works exactly as before, with no account.
# Both values are public by design: security comes from row-level security, not secrecy.
# Never put the service-role or secret key here, in the repo, or in a GitHub variable the build reads.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # or the legacy anon key
# The privacy page (/privacy.html) is published only when a contact address is set as well.
VITE_PRIVACY_CONTACT=
